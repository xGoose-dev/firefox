{
  "name": "xgoose-firefox",
  "version": "0.3.1",
  "private": true,
  "description": "xGoose for Firefox: in-page AI research and website skill manager.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w xgoose-extension-firefox",
    "typecheck": "tsc -p apps/firefox/tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "e2e": "node tests/browser/firefox.mjs",
    "lint:amo": "addons-linter apps/firefox/dist --output json",
    "package": "python3 scripts/package-firefox.py"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@playwright/test": "1.56.1",
    "@types/chrome": "^0.1.42",
    "@types/node": "^25.0.0",
    "addons-linter": "10.15.0",
    "selenium-webdriver": "4.51.0",
    "tsx": "4.20.6",
    "typescript": "^5.7.0",
    "web-ext": "10.8.0",
    "web-streams-polyfill": "4.3.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "overrides": {
    "@google/genai": "2.31.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xGoose-dev/firefox.git"
  }
}
